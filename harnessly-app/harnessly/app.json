{
  "id": "harnessly.docs",
  "name": "Документы",
  "description": "Каталог документов команды: агент находит, читает, сравнивает версии и делится ссылкой; публикует через хаб",
  "version": "0.2.0",
  "harnessly": ">=0.16.68",
  "trust": "sandboxed",
  "targets": [
    "app",
    "pane",
    "chat"
  ],
  "activation": {
    "on": [
      "manual"
    ],
    "openView": "docs"
  },
  "permissions": [
    "chat.prompt",
    "pane.open"
  ],
  "agent": {
    "instructions": "instructions.md",
    "skills": [
      "documents"
    ],
    "tools": {}
  },
  "views": [
    {
      "id": "docs",
      "title": "Документы",
      "entry": "${install:artifactsUrl}/app",
      "targets": [
        "app"
      ]
    },
    {
      "id": "home",
      "title": "Последние документы",
      "entry": "ui/index.html",
      "targets": [
        "pane"
      ]
    }
  ],
  "network": {
    "frames": [
      "${install:artifactsUrl}"
    ]
  }
}
