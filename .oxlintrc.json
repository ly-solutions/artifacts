{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true,
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "node_modules/**",
    "deploy/**",
    "coverage/**"
  ],
  "rules": {
    "eqeqeq": "error",
    "prefer-const": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "no-var": "off",
    "unicorn/no-invalid-fetch-options": "off",
    "no-shadow": "off"
  }
}
